# Postgres connection string (Railway, Neon or Supabase give you one)
DATABASE_URL=postgres://city:city@localhost:5432/city
# Set to 1 if your database host requires SSL (Neon, Supabase, most clouds)
PGSSL=0

# Your builder password. Make it long and random: openssl rand -hex 24
ADMIN_TOKEN=change-me-to-a-long-random-string

# Secret for the cron ping URL: /api/cron/tick?key=THIS
CRON_KEY=change-me-too

# Instagram webhook (fill these in when you connect Instagram)
IG_VERIFY_TOKEN=any-phrase-you-also-type-into-meta
IG_APP_SECRET=from-your-meta-app-settings
SPAWN_KEYWORD=spawn

# Only when running two or more servers: they share live updates through Redis
# REDIS_URL=redis://localhost:6379
# PG_POOL_SIZE=8

PORT=3000
